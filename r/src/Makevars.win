CXX_STD = CXX17
PKG_CPPFLAGS = -I.
# CRAN prohibits non-portable compiler flags such as -ffp-contract=off in Makevars.
# FMA contraction is disabled in the C++ sources: `#pragma STDC FP_CONTRACT OFF`
# on Clang/AppleClang, and `#pragma GCC optimize("-ffp-contract=off")` on GCC.
# Both pragmas were checked against compiler assembly output.
